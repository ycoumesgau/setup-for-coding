{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node skills/kickoff/template/scripts/hooks/session-start.mjs", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node skills/kickoff/template/scripts/hooks/no-verify.mjs", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node skills/kickoff/template/scripts/agent-memory-check.mjs --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
